# EasyCV Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Settings
# =============================================================================

# Provider: openai, anthropic, openrouter, or ollama
EASYCV_LLM_PROVIDER=openrouter

# Model identifier (use provider-specific naming)
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-sonnet-4-20250514, claude-3-5-haiku-20241022
# OpenRouter: anthropic/claude-sonnet-4-20250514, openai/gpt-4o
# Ollama: llama3.1:8b, mistral, qwen2.5, etc.
EASYCV_LLM_MODEL=anthropic/claude-sonnet-4-20250514

# Temperature (0.0 = deterministic, higher = more creative)
EASYCV_LLM_TEMPERATURE=0.0

# Maximum tokens in response
EASYCV_LLM_MAX_TOKENS=4096

# =============================================================================
# Ollama Settings (for local models)
# =============================================================================

# Ollama server URL (default: http://localhost:11434)
# EASYCV_OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# API Keys (set only the one for your chosen provider)
# Ollama doesn't require an API key
# =============================================================================

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
